{
  "name": "desk-escape",
  "description": "A mobile client for [OpenCode](https://opencode.ai) — control your AI coding agent from your phone or tablet.",
  "author": "involvex",
  "repository": {
    "url": "git+https://github.com/involvex/Desk-Escape.git",
    "type": "git"
  },
  "funding": "https://github.com/sponsors/involvex",
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  },
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-local-authentication": "^57.0.2",
    "expo-notifications": "~57.0.10",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "bun scripts/build-terminal-shell.mjs",
    "build:terminal-shell": "bun scripts/build-terminal-shell.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "android": "bun run build:terminal-shell && expo run:android",
    "android:clean": "cmd /c \"cd android && gradlew.bat clean\"",
    "android:install": "bun run build:terminal-shell && expo run:android --variant release --no-bundler",
    "android:release": "bun run check && bunx expo prebuild --platform android && bunx expo run:android --variant release",
    "check": "bun run lint:fix && bun run format && bun run typecheck && bun run check:install && bun run doctor",
    "doctor": "bunx expo-doctor --verbose",
    "check:install": "bunx expo install --check",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "validate:pty": "bun scripts/validate-pty-ws.mjs",
    "validate:terminal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-terminal-android.ps1",
    "release": "powershell -File scripts/release.ps1"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "private": true
}
