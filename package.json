{
  "name": "desk-escape",
  "description": "A mobile client for [OpenCode](https://opencode.ai) — control your AI coding agent from your phone or tablet.",
  "author": "involvex",
  "repository": {
    "url": "git+https://github.com/involvex/Desk-Escape.git",
    "type": "git"
  },
  "funding": "https://github.com/sponsors/involvex",
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  },
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@opencode/client": "2.2.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "bun scripts/build-terminal-shell.mjs",
    "build:terminal-shell": "bun scripts/build-terminal-shell.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "android": "bun run build:terminal-shell && expo run:android",
    "android:clean": "cmd /c \"cd android && gradlew.bat clean\"",
    "android:install": "bun run build:terminal-shell && expo run:android --variant release --no-bundler",
    "android:release": "bun run check && bunx expo prebuild --platform android && bunx expo run:android --variant release",
    "check": "bun run lint:fix && bun run format && bun run typecheck && bun run check:install && bun run doctor",
    "doctor": "bunx expo-doctor --verbose",
    "check:install": "bunx expo install --check",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "validate:pty": "bun scripts/validate-pty-ws.mjs",
    "validate:contracts": "bun scripts/probe-server-contracts.mjs",
    "validate:terminal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-terminal-android.ps1",
    "release": "powershell -File scripts/release.ps1"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "private": true
}
